{% extends "main_card.html.twig" %}

{% block title %}{% trans %}purchase_order.check_in.title{% endtrans %}{% endblock %}

{% block card_title %}
    <i class="fas fa-box-open"></i> {% trans %}purchase_order.check_in.title{% endtrans %}: {{ order.name }}
    <a class="btn btn-outline-secondary btn-sm float-end" href="{{ path('purchase_order_show', {id: order.id}) }}">{% trans %}purchase_order.check_in.back{% endtrans %}</a>
{% endblock %}

{% block card_content %}
    <p class="text-muted">{% trans %}purchase_order.check_in.hint{% endtrans %}</p>

    <form method="post" action="{{ path('purchase_order_check_in', {id: order.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('purchase_order_check_in_' ~ order.id) }}">
        <input type="hidden" name="step" value="review">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 rounded border bg-body-tertiary p-3 mb-3"
             data-check-in-toolbar>
            <div>
                <div class="small fw-semibold text-uppercase text-muted mb-1">
                    {% trans %}purchase_order.check_in.filter.label{% endtrans %}
                </div>
                <div class="btn-group flex-wrap" role="group"
                     aria-label="{{ 'purchase_order.check_in.filter.label'|trans }}">
                    <button type="button" class="btn btn-outline-primary active" data-check-in-filter="all"
                            aria-pressed="true">
                        <i class="fas fa-list me-1"></i>
                        {% trans %}purchase_order.check_in.filter.all{% endtrans %}
                        <span class="badge text-bg-primary ms-1" data-check-in-count="all">0</span>
                    </button>
                    <button type="button" class="btn btn-outline-success" data-check-in-filter="arrived"
                            aria-pressed="false">
                        <i class="fas fa-box-open me-1"></i>
                        {% trans %}purchase_order.check_in.filter.arrived{% endtrans %}
                        <span class="badge text-bg-success ms-1" data-check-in-count="arrived">0</span>
                    </button>
                    <button type="button" class="btn btn-outline-warning" data-check-in-filter="missing"
                            aria-pressed="false">
                        <i class="fas fa-hourglass-half me-1"></i>
                        {% trans %}purchase_order.check_in.filter.missing{% endtrans %}
                        <span class="badge text-bg-warning ms-1" data-check-in-count="missing">0</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-check-in-filter="unavailable"
                            aria-pressed="false">
                        <i class="fas fa-database me-1"></i>
                        {% trans %}purchase_order.check_in.filter.unavailable{% endtrans %}
                        <span class="badge text-bg-secondary ms-1" data-check-in-count="unavailable">0</span>
                    </button>
                </div>
            </div>
            <div>
                <div class="small fw-semibold text-uppercase text-muted mb-1">
                    {% trans %}purchase_order.check_in.bulk.label{% endtrans %}
                </div>
                <div class="btn-group" role="group"
                     aria-label="{{ 'purchase_order.check_in.bulk.label'|trans }}">
                    <button type="button" class="btn btn-outline-success" data-check-in-set-visible="arrived">
                        <i class="fas fa-check-double me-1"></i>
                        {% trans %}purchase_order.check_in.bulk.arrived{% endtrans %}
                    </button>
                    <button type="button" class="btn btn-outline-warning" data-check-in-set-visible="missing">
                        <i class="fas fa-rotate-left me-1"></i>
                        {% trans %}purchase_order.check_in.bulk.missing{% endtrans %}
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>{% trans %}purchase_order.check_in.include{% endtrans %}</th>
                    <th>{% trans %}part.edit.name{% endtrans %}</th>
                    <th>{% trans %}purchase_order.quantity{% endtrans %}</th>
                    <th>{% trans %}purchase_order.received{% endtrans %}</th>
                    <th>{% trans %}purchase_order.outstanding{% endtrans %}</th>
                    <th>{% trans %}purchase_order.check_in.received_now{% endtrans %}</th>
                    <th>{% trans %}purchase_order.check_in.where{% endtrans %}</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    {% set line = row.line %}
                    {% set line_arrivals = arrivals[line.id]|default([]) %}
                    <tr data-line-id="{{ line.id }}" data-check-in-row
                        data-check-in-state="{{ line.inDatabase ? 'missing' : 'unavailable' }}"
                        class="{{ line.inDatabase ? 'table-warning' : 'table-secondary text-muted' }}">
                        <td style="min-width: 15rem">
                            {% if line.inDatabase %}
                                <input class="d-none" id="check-in-line-{{ line.id }}" type="checkbox"
                                       name="check[{{ line.id }}]" value="1" autocomplete="off"
                                       data-check-in tabindex="-1" aria-hidden="true">
                                <div class="btn-group w-100" role="group"
                                     aria-label="{{ 'purchase_order.check_in.status.label'|trans }}">
                                    <button type="button" class="btn btn-warning active text-nowrap"
                                            data-check-in-choice="missing" aria-pressed="true">
                                        <i class="fas fa-hourglass-half me-1"></i>
                                        {% trans %}purchase_order.check_in.status.missing{% endtrans %}
                                    </button>
                                    <button type="button" class="btn btn-outline-success text-nowrap"
                                            data-check-in-choice="arrived" aria-pressed="false">
                                        <i class="fas fa-check me-1"></i>
                                        {% trans %}purchase_order.check_in.status.arrived{% endtrans %}
                                    </button>
                                </div>
                            {% else %}
                                <span class="badge text-bg-secondary fs-6 w-100 py-3 text-wrap">
                                    <i class="fas fa-database me-1"></i>
                                    {% trans %}purchase_order.check_in.add_to_database_first{% endtrans %}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <strong>{{ line.label }}</strong>
                            {% if not line.inDatabase %}
                                <div class="small text-danger mt-1">
                                    {% trans %}purchase_order.check_in.external_not_available{% endtrans %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">{{ line.quantity }}</span>
                        </td>
                        <td>
                            <span class="badge bg-success rounded-pill fs-6 px-3 py-2">{{ line.quantityReceived }}</span>
                            {% if line_arrivals is not empty %}
                                <div class="mt-2">
                                    {% for arrival in line_arrivals %}
                                        <div class="small text-muted text-nowrap">
                                            <i class="fas fa-clock fa-fw"></i>
                                            +{{ arrival.quantity }} · {{ arrival.at|format_datetime('medium', 'short') }}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-warning text-dark rounded-pill fs-6 px-3 py-2">{{ line.outstanding }}</span>
                        </td>
                        <td>
                            {% if line.inDatabase %}
                                <input class="form-control" type="number" min="0" step="1"
                                       name="qty[{{ line.id }}]" value="{{ line.outstanding }}"
                                       data-check-qty data-check-in-detail data-outstanding="{{ line.outstanding }}">
                            {% else %}
                                <input class="form-control" type="number" value="{{ line.outstanding }}" disabled>
                            {% endif %}
                        </td>
                        <td data-check-in-destination>
                            {% if line.inDatabase %}
                                {% if row.lots|length == 1 %}
                                    <input type="hidden" name="lot[{{ line.id }}]" value="{{ row.lots[0].id }}"
                                           data-check-in-detail>
                                    {{ row.lotLabels[row.lots[0].id] }}
                                {% elseif row.lots|length > 1 %}
                                    <select class="form-select" name="lot[{{ line.id }}]" data-check-in-detail>
                                        <option value="">{% trans %}purchase_order.check_in.choose_lot_option{% endtrans %}</option>
                                        {% for lot in row.lots %}
                                            <option value="{{ lot.id }}">{{ row.lotLabels[lot.id] }}</option>
                                        {% endfor %}
                                    </select>
                                {% else %}
                                    <select class="form-select" name="location[{{ line.id }}]" data-check-in-detail>
                                        <option value="">{% trans %}purchase_order.check_in.choose_location_option{% endtrans %}</option>
                                        {% for location in row.locations %}
                                            <option value="{{ location.id }}">{{ location.name }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            {% else %}
                                <span class="text-danger fw-semibold">
                                    <i class="fas fa-circle-exclamation me-1"></i>
                                    {% trans %}purchase_order.check_in.add_to_database_first{% endtrans %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mb-3">
            <label class="form-label" for="purchase-order-check-in-comment">{% trans %}purchase_order.check_in.comment{% endtrans %}</label>
            <textarea class="form-control" id="purchase-order-check-in-comment" name="comment" rows="2" maxlength="255">{{ comment }}</textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            {% trans %}purchase_order.check_in.review{% endtrans %}
            <span class="badge text-bg-light ms-1" data-check-in-selected-count>0</span>
        </button>
    </form>

    <script>
        (() => {
        const checkInRows = Array.from(document.querySelectorAll('[data-check-in-row]'));
        const checkInFilterButtons = Array.from(document.querySelectorAll('[data-check-in-filter]'));
        let checkInFilter = 'all';

        const refreshCheckInView = () => {
            const counts = {all: checkInRows.length, arrived: 0, missing: 0, unavailable: 0};

            checkInRows.forEach((row) => {
                counts[row.dataset.checkInState] += 1;
                row.classList.toggle('d-none', checkInFilter !== 'all' && row.dataset.checkInState !== checkInFilter);
            });

            Object.entries(counts).forEach(([state, count]) => {
                const badge = document.querySelector(`[data-check-in-count="${state}"]`);
                if (badge) {
                    badge.textContent = count;
                }
                const filter = document.querySelector(`[data-check-in-filter="${state}"]`);
                if (filter && state !== 'all') {
                    filter.disabled = count === 0;
                }
            });

            const selectedCount = document.querySelector('[data-check-in-selected-count]');
            if (selectedCount) {
                selectedCount.textContent = counts.arrived;
            }
        };

        document.querySelectorAll('[data-check-in]').forEach((box) => {
            const updateToggle = () => {
                const row = box.closest('tr');
                const missing = row.querySelector('[data-check-in-choice="missing"]');
                const arrived = row.querySelector('[data-check-in-choice="arrived"]');
                const qty = row.querySelector('[data-check-qty]');

                row.dataset.checkInState = box.checked ? 'arrived' : 'missing';
                row.classList.toggle('table-success', box.checked);
                row.classList.toggle('table-warning', !box.checked);

                missing.classList.toggle('btn-warning', !box.checked);
                missing.classList.toggle('btn-outline-warning', box.checked);
                missing.classList.toggle('active', !box.checked);
                missing.setAttribute('aria-pressed', String(!box.checked));
                arrived.classList.toggle('btn-success', box.checked);
                arrived.classList.toggle('btn-outline-success', !box.checked);
                arrived.classList.toggle('active', box.checked);
                arrived.setAttribute('aria-pressed', String(box.checked));

                row.querySelectorAll('[data-check-in-detail]').forEach((control) => {
                    control.disabled = !box.checked;
                });
                const destination = row.querySelector('[data-check-in-destination]');
                destination.classList.toggle('opacity-50', !box.checked);

                if (qty && box.checked && (qty.value === '' || Number(qty.value) === 0)) {
                    qty.value = qty.dataset.outstanding;
                }

                refreshCheckInView();
            };

            box.closest('tr').querySelectorAll('[data-check-in-choice]').forEach((choice) => {
                choice.addEventListener('click', () => {
                    box.checked = choice.dataset.checkInChoice === 'arrived';
                    box.dispatchEvent(new Event('change', {bubbles: true}));
                });
            });
            box.addEventListener('change', updateToggle);
            updateToggle();
        });

        checkInFilterButtons.forEach((filter) => {
            filter.addEventListener('click', () => {
                checkInFilter = filter.dataset.checkInFilter;
                checkInFilterButtons.forEach((button) => {
                    const active = button === filter;
                    button.classList.toggle('active', active);
                    button.setAttribute('aria-pressed', String(active));
                });
                refreshCheckInView();
            });
        });

        document.querySelectorAll('[data-check-in-set-visible]').forEach((button) => {
            button.addEventListener('click', () => {
                const arrived = button.dataset.checkInSetVisible === 'arrived';
                checkInRows.filter((row) => !row.classList.contains('d-none')).forEach((row) => {
                    const box = row.querySelector('[data-check-in]');
                    if (box) {
                        box.checked = arrived;
                        box.dispatchEvent(new Event('change', {bubbles: true}));
                    }
                });
            });
        });

        refreshCheckInView();
        })();
    </script>
{% endblock %}
