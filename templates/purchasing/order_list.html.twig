{% extends "main_card.html.twig" %}

{% block title %}{% trans %}purchase_order.list.title{% endtrans %}{% endblock %}

{% block card_title %}
    <i class="fas fa-cart-shopping"></i> {% trans %}purchase_order.list.title{% endtrans %}
{% endblock %}

{% block card_content %}
    <p class="text-muted">{% trans %}purchase_order.list.hint{% endtrans %}</p>

    {% if is_granted('@parts.edit') %}
        <form class="row g-2 align-items-end mb-3" method="post" action="{{ path('purchase_order_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('purchase_order_create') }}">
            <div class="col-sm-6 col-md-4">
                <label class="form-label" for="purchase-order-new-name">{% trans %}purchase_order.name_optional{% endtrans %}</label>
                <input class="form-control" id="purchase-order-new-name" type="text" name="name" maxlength="255">
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" type="submit">{% trans %}purchase_order.create{% endtrans %}</button>
            </div>
        </form>
    {% endif %}

    {% if orders is empty %}
        <p>{% trans %}purchase_order.list.empty{% endtrans %}</p>
    {% else %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{% trans %}purchase_order.name{% endtrans %}</th>
                <th>{% trans %}purchase_order.created{% endtrans %}</th>
                <th>{% trans %}purchase_order.lines{% endtrans %}</th>
            </tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr>
                    <td><a href="{{ path('purchase_order_show', {id: order.id}) }}">{{ order.name }}</a></td>
                    <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    <td>{{ order.lines|length }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
