{% extends 'main_card.html.twig' %}

{% block title %}{% trans %}label_generator.bpac_print{% endtrans %}{% endblock %}

{%- block card_title -%}
    <i class="fas fa-print fa-fw"></i> {% trans %}label_generator.bpac_print{% endtrans %}
    {% if profile %}({{ profile.name }}){% endif %}
{%- endblock -%}

{% block card_content %}
    <p>
        {% trans with {'%width%': label_width, '%height%': label_height, '%labels%': job.labels|length} %}label_generator.bpac_launch.summary{% endtrans %}
    </p>

    {% if fits_protocol %}
        <p class="text-muted">{% trans %}label_generator.bpac_print.hint{% endtrans %}</p>
        <a class="btn btn-success" data-turbo="false" href="{{ protocol_url }}">
            <i class="fa-solid fa-print fa-fw"></i>
            {% trans %}label_generator.bpac_print{% endtrans %}
        </a>
        <script>
            window.location.href = {{ protocol_url|json_encode|raw }};
        </script>
    {% else %}
        <p class="text-muted">{% trans %}label_generator.bpac_launch.download_hint{% endtrans %}</p>
    {% endif %}

    <a class="btn btn-outline-secondary" data-turbo="false" href="{{ 'data:application/json;charset=utf-8,' ~ job_json|url_encode }}" download="partdb-ptouch.ptjob">
        <i class="fa-solid fa-file-arrow-down fa-fw"></i>
        {% trans %}label_generator.bpac_job{% endtrans %}
    </a>

    <script type="application/json" id="bpac_print_job">{{ job_json|raw }}</script>
{% endblock %}
