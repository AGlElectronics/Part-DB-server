<table class="stacked-label">
    <tr>
        <td class="stacked-barcode">
            <a href="{{ element.barcode_content }}">
                <img class="stacked-qr" src="{{ element.barcode | data_uri(mime='image/svg+xml') }}" alt="">
            </a>
        </td>
    </tr>
    <tr>
        <td class="stacked-text">
            {{ element.lines | raw }}
        </td>
    </tr>
</table>
